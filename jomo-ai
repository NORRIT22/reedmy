          settingsTitle: 'إعدادات المزود ومساحة العمل',
          providerPreset: 'مزود الخدمة',
          securityNote: 'تُحفظ الإعدادات في الجلسة المحلية للمتصفح فقط للاستخدام الفردي. في بيئة الإنتاج يجب حفظ المفاتيح على الخادم.',
          testConnection: 'اختبار الاتصال',
          save: 'حفظ',
          milestonePending: 'هذه الوحدة مبرمجة في المرحلة القادمة من التطوير. لا يتم عرض أي وظائف وهمية.'
        },
        fr: {
          dir: 'ltr',
          newChat: 'Nouvelle discussion',
          search: 'Rechercher',
          library: 'Bibliothèque',
          projects: 'Projets',
          agents: 'Agents',
          studio: 'Studio',
          automations: 'Automatisations',
          history: 'Discussions',
          settings: 'Paramètres & Fournisseur',
          welcome: 'Que souhaitez-vous accomplir ?',
          placeholder: 'Posez une question, collez du code ou joignez un fichier texte...',
          send: 'Envoyer',
          stop: 'Arrêter',
          copy: 'Copier',
          copied: 'Copié',
          retry: 'Réessayer',
          modeAuto: 'Auto',
          modePro: 'Pro',
          shortcutResearch: 'Recherche',
          shortcutCreate: 'Créer',
          shortcutCode: 'Code',
          shortcutAnalyze: 'Analyser',
          shortcutAgent: 'Agent',
          unconfiguredBanner: 'Aucun fournisseur IA connecté. Configurez Ollama (local/gratuit) ou une API compatible OpenAI dans les paramètres.',
          configureNow: 'Configurer',
          settingsTitle: 'Paramètres du fournisseur',
          providerPreset: 'Préréglage du fournisseur',
          securityNote: 'Enregistré uniquement dans la session locale du navigateur. En production, conservez les clés côté serveur.',
          testConnection: 'Tester la connexion',
          save: 'Enregistrer',
          milestonePending: 'Ce module est prévu pour une prochaine étape. Aucune fonctionnalité simulée n’est affichée.'
        }
      };

      const PRESETS = {
        ollama: { baseUrl: 'http://localhost:11434/v1', model: 'qwen2.5:7b' },
        groq: { baseUrl: 'https://api.groq.com/openai/v1', model: 'llama-3.3-70b-versatile' },
        openrouter: { baseUrl: 'https://openrouter.ai/api/v1', model: 'meta-llama/llama-3.3-70b-instruct:free' },
        custom: { baseUrl: '', model: '' }
      };

      const state = {
        lang: localStorage.getItem('jomo_lang') || 'en',
        view: 'chat',
        mode: 'auto',
        taskType: 'chat',
        conversations: JSON.parse(localStorage.getItem('jomo_convs_v1') || '[]'),
        activeConvId: null,
        attachments: [],
        isStreaming: false,
        abortController: null,
        provider: JSON.parse(sessionStorage.getItem('jomo_provider_cfg') || 'null') || {
          preset: 'ollama',
          baseUrl: 'http://localhost:11434/v1',
          model: 'qwen2.5:7b',
          apiKey: '',
          verified: false
        }
      };

      function saveConversations() {
        localStorage.setItem('jomo_convs_v1', JSON.stringify(state.conversations));
      }

      function saveProvider() {
        sessionStorage.setItem('jomo_provider_cfg', JSON.stringify(state.provider));
        updateProviderIndicator();
      }

      function t(key) {
        return (I18N[state.lang] && I18N[state.lang][key]) || I18N.en[key] || key;
      }

      function applyLanguage() {
        const dict = I18N[state.lang] || I18N.en;
        document.documentElement.lang = state.lang;
        document.documentElement.dir = dict.dir;
        document.querySelectorAll('[data-i18n]').forEach(el => {
          const k = el.getAttribute('data-i18n');
          if (dict[k]) el.textContent = dict[k];
        });
        document.querySelectorAll('.lang-btn').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.lang === state.lang);
        });
        renderMain();
      }

      function updateProviderIndicator() {
        const dot = document.getElementById('providerDot');
        const txt = document.getElementById('providerStatusText');
        const banner = document.getElementById('unconfiguredBanner');
        const isConfigured = Boolean(state.provider.baseUrl && state.provider.model && (state.provider.verified || state.provider.apiKey));
        dot.classList.toggle('ready', isConfigured);
        txt.textContent = isConfigured ? `${state.provider.model}` : 'Not Configured';
        banner.classList.toggle('hidden', isConfigured);
      }

      function renderSidebarHistory() {
        const list = document.getElementById('conversationList');
        list.innerHTML = '';
        state.conversations.forEach(conv => {
          const row = document.createElement('div');
          row.className = 'conv-item' + (conv.id === state.activeConvId ? ' active' : '');
          const title = document.createElement('span');
          title.className = 'conv-title';
          title.textContent = conv.title;
          title.onclick = () => {
            state.activeConvId = conv.id;
            state.view = 'chat';
            renderAll();
          };
          const del = document.createElement('button');
          del.className = 'conv-del';
          del.textContent = '×';
          del.onclick = (e) => {
            e.stopPropagation();
            state.conversations = state.conversations.filter(c => c.id !== conv.id);
            if (state.activeConvId === conv.id) state.activeConvId = null;
            saveConversations();
            renderAll();
          };
          row.appendChild(title);
          row.appendChild(del);
          list.appendChild(row);
        });
      }

      function buildComposerHTML() {
        const shortcuts = [
          { id: 'research', label: t('shortcutResearch') },
          { id: 'create', label: t('shortcutCreate') },
          { id: 'code', label: t('shortcutCode') },
          { id: 'analyze', label: t('shortcutAnalyze') },
          { id: 'agent', label: t('shortcutAgent') }
        ];
        const attChips = state.attachments.map((a, idx) =>
          `<span class="att-chip">📄 ${escapeHtml(a.name)} <button type="button" data-rm-att="${idx}" style="background:none;border:none;color:inherit;cursor:pointer;">×</button></span>`
        ).join('');

        return `
          <div class="composer-box">
            ${attChips ? `<div class="attachment-strip">${attChips}</div>` : ''}
            <textarea id="promptInput" class="composer-textarea" placeholder="${escapeHtml(t('placeholder'))}"></textarea>
            <div class="composer-toolbar">
              <div class="toolbar-left">
                <div class="mode-group">
                  <button type="button" class="mode-btn ${state.mode === 'auto' ? 'active' : ''}" data-mode="auto">${t('modeAuto')}</button>
                  <button type="button" class="mode-btn ${state.mode === 'pro' ? 'active' : ''}" data-mode="pro">${t('modePro')}</button>
                </div>
                <label class="task-chip" style="cursor:pointer;">
                  + File
                  <input id="fileAttachInput" type="file" accept=".txt,.md,.csv,.json,.js,.py,.html,.css" style="display:none;" />
                </label>
                ${shortcuts.map(s => `
                  <button type="button" class="task-chip ${state.taskType === s.id ? 'active' : ''}" data-task="${s.id}">${s.label}</button>
                `).join('')}
              </div>
              <div>
                ${state.isStreaming
                  ? `<button type="button" id="stopBtn" class="stop-btn">${t('stop')}</button>`
                  : `<button type="button" id="sendBtn" class="send-btn">${t('send')}</button>`}
              </div>
            </div>
          </div>
        `;
      }

      function bindComposerEvents(container) {
        const input = container.querySelector('#promptInput');
        const sendBtn = container.querySelector('#sendBtn');
        const stopBtn = container.querySelector('#stopBtn');
        const fileInput = container.querySelector('#fileAttachInput');

        container.querySelectorAll('[data-mode]').forEach(btn => {
          btn.onclick = () => {
            state.mode = btn.dataset.mode;
            renderMain();
          };
        });

        container.querySelectorAll('[data-task]').forEach(btn => {
          btn.onclick = () => {
            state.taskType = state.taskType === btn.dataset.task ? 'chat' : btn.dataset.task;
            renderMain();
          };
        });

        container.querySelectorAll('[data-rm-att]').forEach(btn => {
          btn.onclick = () => {
            const idx = Number(btn.dataset.rmAtt);
            state.attachments.splice(idx, 1);
            renderMain();
          };
        });

        if (fileInput) {
          fileInput.onchange = async (e) => {
            const file = e.target.files[0];
            if (!file) return;
            if (file.size > 200 * 1024) {
              alert('File exceeds 200 KB text limit in Milestone 1.');
              return;
            }
            const text = await file.text();
            state.attachments.push({ name: file.name, content: text });
            renderMain();
          };
        }

        if (input) {
          input.onkeydown = (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
              e.preventDefault();
              handleSend(input.value);
            }
          };
        }
        if (sendBtn) sendBtn.onclick = () => handleSend(input.value);
        if (stopBtn) stopBtn.onclick = () => state.abortController && state.abortController.abort();
      }

      function formatMessageContent(raw) {
        const escaped = escapeHtml(raw);
        return escaped.replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>');
      }

      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function renderMain() {
        const canvas = document.getElementById('canvasArea');
        const dock = document.getElementById('composerDock');
        const titleEl = document.getElementById('workspaceTitle');

        document.querySelectorAll('.nav-item[data-view]').forEach(el => {
          el.classList.toggle('active', el.dataset.view === state.view);
        });

        if (state.view !== 'chat') {
          dock.style.display = 'none';
          titleEl.textContent = t(state.view);
          canvas.innerHTML = `
            <div class="subview-card">
              <h2 style="margin-bottom:10px; font-size:1.1rem;">${escapeHtml(t(state.view))}</h2>
              <p style="font-size:0.86rem; color:var(--text-secondary); line-height:1.6;">${escapeHtml(t('milestonePending'))}</p>
              <button class="btn-new-chat" style="margin-top:16px;" id="backToChatBtn">${escapeHtml(t('newChat'))}</button>
            </div>
          `;
          document.getElementById('backToChatBtn').onclick = () => {
            state.view = 'chat';
            renderAll();
          };
          return;
        }

        const activeConv = state.conversations.find(c => c.id === state.activeConvId);
        if (!activeConv) {
          titleEl.textContent = 'JOMO AI Workspace';
          dock.style.display = 'none';
          canvas.innerHTML = `
            <div class="home-hero">
              <h1>${escapeHtml(t('welcome'))}</h1>
              <div id="heroComposerMount">${buildComposerHTML()}</div>
            </div>
          `;
          bindComposerEvents(document.getElementById('heroComposerMount'));
          return;
        }

        titleEl.textContent = activeConv.title;
        canvas.innerHTML = `<div class="messages-wrap" id="messagesWrap"></div>`;
        const wrap = document.getElementById('messagesWrap');

        activeConv.messages.forEach((msg) => {
          const card = document.createElement('div');
          card.className = 'msg-card ' + msg.role;
          card.innerHTML = `
            <div class="msg-meta">
              <span>${msg.role === 'user' ? 'YOU' : 'JOMO AI'}</span>
              <span>${msg.model ? escapeHtml(msg.model) : ''}</span>
            </div>
            <div class="msg-body">${formatMessageContent(msg.content)}</div>
            ${msg.error ? `<div class="msg-error">${escapeHtml(msg.error)}</div>` : ''}
            <div class="msg-actions">
              <button class="mini-btn" data-copy-msg="${msg.id}">${escapeHtml(t('copy'))}</button>
            </div>
          `;
          card.querySelector('[data-copy-msg]').onclick = (e) => {
            navigator.clipboard.writeText(msg.content);
            e.target.textContent = t('copied');
            setTimeout(() => (e.target.textContent = t('copy')), 1200);
          };
          wrap.appendChild(card);
        });

        dock.style.display = 'block';
        dock.innerHTML = buildComposerHTML();
        bindComposerEvents(dock);
        canvas.scrollTop = canvas.scrollHeight;
      }

      async function handleSend(rawText) {
        const text = (rawText || '').trim();
        if (!text || state.isStreaming) return;

        let fullPrompt = text;
        if (state.attachments.length > 0) {
          const filesBlock = state.attachments
            .map(f => `[Attached File: ${f.name}]\n${f.content}`)
            .join('\n\n');
          fullPrompt = `${filesBlock}\n\nUser Request: ${text}`;
        }

        let conv = state.conversations.find(c => c.id === state.activeConvId);
        if (!conv) {
          conv = {
            id: 'conv_' + Date.now(),
            title: text.slice(0, 46),
            messages: []
          };
          state.conversations.unshift(conv);
          state.activeConvId = conv.id;
        }

        conv.messages.push({
          id: 'm_' + Date.now(),
          role: 'user',
          content: text,
          rawPrompt: fullPrompt
        });

        const assistantMsg = {
          id: 'm_' + (Date.now() + 1),
          role: 'assistant',
          content: '',
          model: state.provider.model,
          error: null
        };
        conv.messages.push(assistantMsg);
        state.attachments = [];
        state.isStreaming = true;
        saveConversations();
        renderAll();

        if (!state.provider.baseUrl || !state.provider.model) {
          assistantMsg.error = t('unconfiguredBanner');
          state.isStreaming = false;
          saveConversations();
          renderMain();
          return;
        }

        const controller = new AbortController();
        state.abortController = controller;

        try {
          const apiMessages = [
            {
              role: 'system',
              content: `You are JOMO AI. Active task mode: ${state.taskType}. Respond accurately and concisely in the user's language. Never fabricate citations or capabilities.`
            },
            ...conv.messages
              .filter(m => m.id !== assistantMsg.id)
              .map(m => ({ role: m.role, content: m.rawPrompt || m.content }))
          ];

          const headers = { 'Content-Type': 'application/json' };
          if (state.provider.apiKey) {
            headers['Authorization'] = `Bearer ${state.provider.apiKey}`;
          }

          const res = await fetch(`${state.provider.baseUrl.replace(/\/$/, '')}/chat/completions`, {
            method: 'POST',
            headers,
            body: JSON.stringify({
              model: state.provider.model,
              messages: apiMessages,
              stream: true
            }),
            signal: controller.signal
          });

          if (!res.ok) {
            const errTxt = await res.text().catch(() => '');
            throw new Error(`HTTP ${res.status}: ${errTxt.slice(0, 180) || res.statusText}`);
          }

          state.provider.verified = true;
          saveProvider();

          const reader = res.body.getReader();
          const decoder = new TextDecoder();
          let buffer = '';

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            const lines = buffer.split('\n');
            buffer = lines.pop() || '';
            for (const line of lines) {
              const trimmed = line.trim();
              if (!trimmed.startsWith('data:')) continue;
              const payload = trimmed.slice(5).trim();
              if (payload === '[DONE]') continue;
              try {
                const json = JSON.parse(payload);
                const delta = json.choices?.[0]?.delta?.content;
                if (delta) {
                  assistantMsg.content += delta;
                  renderMain();
                }
              } catch (_) {}
            }
          }
        } catch (err) {
          if (err.name !== 'AbortError') {
            assistantMsg.error = `Connection failed: ${err.message}. Verify that your endpoint (${state.provider.baseUrl}) is running and allows browser CORS, or run via a Next.js backend proxy.`;
          }
        } finally {
          state.isStreaming = false;
          state.abortController = null;
          saveConversations();
          renderAll();
        }
      }

      function renderAll() {
        renderSidebarHistory();
        renderMain();
      }

      // Wire static UI controls
      document.getElementById('toggleSidebarBtn').onclick = () => {
        document.getElementById('sidebar').classList.toggle('collapsed');
      };
      document.getElementById('mobileMenuBtn').onclick = () => {
        document.getElementById('sidebar').classList.toggle('collapsed');
      };
      document.getElementById('newChatBtn').onclick = () => {
        state.activeConvId = null;
        state.view = 'chat';
        renderAll();
      };
      document.querySelectorAll('.nav-item[data-view]').forEach(btn => {
        btn.onclick = () => {
          state.view = btn.dataset.view;
          renderAll();
        };
      });
      document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.onclick = () => {
          state.lang = btn.dataset.lang;
          localStorage.setItem('jomo_lang', state.lang);
          applyLanguage();
        };
      });

      // Settings Modal
      const settingsModal = document.getElementById('settingsModal');
      const openSettings = () => {
        document.getElementById('providerPresetSelect').value = state.provider.preset || 'ollama';
        document.getElementById('providerBaseUrl').value = state.provider.baseUrl || '';
        document.getElementById('providerModelId').value = state.provider.model || '';
        document.getElementById('providerApiKey').value = state.provider.apiKey || '';
        document.getElementById('settingsFeedback').textContent = '';
        settingsModal.classList.add('open');
      };
      document.getElementById('openSettingsBtn').onclick = openSettings;
      document.getElementById('bannerConfigBtn').onclick = openSettings;
      document.getElementById('closeSettingsBtn').onclick = () => settingsModal.classList.remove('open');

      document.getElementById('providerPresetSelect').onchange = (e) => {
        const p = PRESETS[e.target.value];
        if (p && e.target.value !== 'custom') {
          document.getElementById('providerBaseUrl').value = p.baseUrl;
          document.getElementById('providerModelId').value = p.model;
        }
      };

      document.getElementById('saveSettingsBtn').onclick = () => {
        state.provider = {
          preset: document.getElementById('providerPresetSelect').value,
          baseUrl: document.getElementById('providerBaseUrl').value.trim(),
          model: document.getElementById('providerModelId').value.trim(),
          apiKey: document.getElementById('providerApiKey').value.trim(),
          verified: state.provider.verified
        };
        saveProvider();
        settingsModal.classList.remove('open');
      };

      document.getElementById('testConnectionBtn').onclick = async () => {
        const fb = document.getElementById('settingsFeedback');
        const baseUrl = document.getElementById('providerBaseUrl').value.trim().replace(/\/$/, '');
        const apiKey = document.getElementById('providerApiKey').value.trim();
        fb.textContent = 'Testing endpoint...';
        try {
          const headers = {};
          if (apiKey) headers['Authorization'] = `Bearer ${apiKey}`;
          const res = await fetch(`${baseUrl}/models`, { headers });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          state.provider.verified = true;
          saveProvider();
          fb.style.color = '#3ea873';
          fb.textContent = 'Connected successfully. Endpoint reachable.';
        } catch (err) {
          fb.style.color = '#f4a6a6';
          fb.textContent = `Connection error: ${err.message}`;
        }
      };

      // Command Palette
      const cmdModal = document.getElementById('cmdModal');
      const cmdInput = document.getElementById('cmdInput');
      const openCmd = () => {
        cmdModal.classList.add('open');
        cmdInput.value = '';
        renderCmdResults('');
        cmdInput.focus();
      };
      function renderCmdResults(q) {
        const box = document.getElementById('cmdResults');
        const matches = state.conversations.filter(c => c.title.toLowerCase().includes(q.toLowerCase()));
        box.innerHTML = `
          <div class="conv-item" id="cmdNewChat" style="color:var(--accent);">+ ${escapeHtml(t('newChat'))}</div>
          ${matches.map(c => `<div class="conv-item" data-cmd-conv="${c.id}">${escapeHtml(c.title)}</div>`).join('')}
        `;
        box.querySelector('#cmdNewChat').onclick = () => {
          state.activeConvId = null;
          state.view = 'chat';
          cmdModal.classList.remove('open');
          renderAll();
        };
        box.querySelectorAll('[data-cmd-conv]').forEach(el => {
          el.onclick = () => {
            state.activeConvId = el.dataset.cmdConv;
            state.view = 'chat';
            cmdModal.classList.remove('open');
            renderAll();
          };
        });
      }
      document.getElementById('cmdTriggerBtn').onclick = openCmd;
      cmdInput.oninput = (e) => renderCmdResults(e.target.value);
      cmdModal.onclick = (e) => { if (e.target === cmdModal) cmdModal.classList.remove('open'); };
      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          cmdModal.classList.contains('open') ? cmdModal.classList.remove('open') : openCmd();
        } else if (e.key === 'Escape') {
          cmdModal.classList.remove('open');
          settingsModal.classList.remove('open');
        }
      });

      // Init
      updateProviderIndicator();
      applyLanguage();
      renderSidebarHistory();
    })();
  </script>
</body>
