<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>JOMO AI — Workspace</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-canvas: #0d0e11;
      --bg-surface: #14161b;
      --bg-elevated: #1c1f26;
      --border-subtle: #262a34;
      --text-primary: #f1f3f5;
      --text-secondary: #9aa1b0;
      --accent: #d4a359;
      --accent-dim: rgba(212, 163, 89, 0.14);
      --danger: #e05252;
      --danger-dim: rgba(224, 82, 82, 0.14);
      --ok: #3ea873;
      --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
      --font-serif: 'Amiri', Georgia, serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      height: 100%;
      background: var(--bg-canvas);
      color: var(--text-primary);
      font-family: var(--font-sans);
      overflow: hidden;
    }

    /* Layout */
    .app-shell {
      display: flex;
      height: 100vh;
      width: 100vw;
    }

    /* Sidebar */
    .sidebar {
      width: 268px;
      background: var(--bg-surface);
      border-inline-end: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      transition: width 0.18s ease;
      flex-shrink: 0;
    }
    .sidebar.collapsed { width: 64px; }
    .sidebar.collapsed .hide-collapsed { display: none; }

    .sidebar-header {
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 14px;
      border-bottom: 1px solid var(--border-subtle);
    }
    .brand {
      font-family: var(--font-serif);
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .brand span { color: var(--accent); }

    .icon-btn {
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-secondary);
      border-radius: 6px;
      padding: 6px 8px;
      cursor: pointer;
      font-size: 0.9rem;
    }
    .icon-btn:hover { background: var(--bg-elevated); color: var(--text-primary); }

    .new-chat-wrap { padding: 12px; }
    .btn-new-chat {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: var(--bg-elevated);
      border: 1px solid var(--border-subtle);
      color: var(--text-primary);
      padding: 9px 12px;
      border-radius: 8px;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
    }
    .btn-new-chat:hover { border-color: var(--accent); }

    .nav-list { padding: 0 8px; display: flex; flex-direction: column; gap: 2px; }
    .nav-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 8px 10px;
      border-radius: 6px;
      border: none;
      background: transparent;
      color: var(--text-secondary);
      font-size: 0.85rem;
      cursor: pointer;
      text-align: start;
    }
    .nav-item:hover, .nav-item.active { background: var(--bg-elevated); color: var(--text-primary); }
    .badge {
      font-size: 0.68rem;
      background: var(--bg-canvas);
      border: 1px solid var(--border-subtle);
      padding: 1px 6px;
      border-radius: 4px;
      color: var(--text-secondary);
    }

    .history-section {
      flex: 1;
      overflow-y: auto;
      margin-top: 12px;
      padding: 10px 8px;
      border-top: 1px solid var(--border-subtle);
    }
    .history-title {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-secondary);
      padding: 0 10px 8px;
    }
    .conv-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 10px;
      border-radius: 6px;
      font-size: 0.84rem;
      color: var(--text-secondary);
      cursor: pointer;
      gap: 6px;
    }
    .conv-item:hover, .conv-item.active { background: var(--bg-elevated); color: var(--text-primary); }
    .conv-title { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .conv-del {
      opacity: 0;
      background: none;
      border: none;
      color: var(--text-secondary);
      cursor: pointer;
      font-size: 1rem;
    }
    .conv-item:hover .conv-del { opacity: 1; }
    .conv-del:hover { color: var(--danger); }

    .sidebar-footer {
      padding: 10px 8px;
      border-top: 1px solid var(--border-subtle);
    }

    /* Main Area */
    .main-area {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .topbar {
      height: 56px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 20px;
      gap: 12px;
    }
    .topbar-left { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .workspace-label {
      font-size: 0.84rem;
      color: var(--text-secondary);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.75rem;
      padding: 4px 10px;
      border-radius: 99px;
      border: 1px solid var(--border-subtle);
      background: var(--bg-surface);
      color: var(--text-secondary);
    }
    .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--danger); }
    .dot.ready { background: var(--ok); }

    .lang-switch { display: flex; gap: 4px; }
    .lang-btn {
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-secondary);
      font-size: 0.78rem;
      padding: 4px 8px;
      border-radius: 5px;
      cursor: pointer;
    }
    .lang-btn.active {
      background: var(--bg-elevated);
      border-color: var(--border-subtle);
      color: var(--accent);
    }

    /* Banner */
    .notice-banner {
      background: rgba(212, 163, 89, 0.1);
      border-bottom: 1px solid rgba(212, 163, 89, 0.28);
      color: #f3d299;
      padding: 9px 20px;
      font-size: 0.8rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .notice-banner.hidden { display: none; }
    .btn-link {
      background: none;
      border: 1px solid rgba(212, 163, 89, 0.45);
      color: #f3d299;
      padding: 3px 9px;
      border-radius: 5px;
      font-size: 0.75rem;
      cursor: pointer;
    }

    /* Home / Chat Feed */
    .canvas {
      flex: 1;
      overflow-y: auto;
      padding: 24px 16px;
      display: flex;
      flex-direction: column;
    }
    .home-hero {
      margin: auto;
      width: 100%;
      max-width: 740px;
      text-align: center;
    }
    .home-hero h1 {
      font-family: var(--font-serif);
      font-size: 2.1rem;
      font-weight: 700;
      margin-bottom: 24px;
      color: var(--text-primary);
    }

    .messages-wrap {
      width: 100%;
      max-width: 760px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }
    .msg-card {
      padding: 16px 18px;
      border-radius: 12px;
      border: 1px solid var(--border-subtle);
      background: var(--bg-surface);
    }
    .msg-card.assistant {
      background: transparent;
      border-color: transparent;
      padding-inline: 4px;
    }
    .msg-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.74rem;
      color: var(--text-secondary);
      margin-bottom: 8px;
    }
    .msg-body {
      font-size: 0.94rem;
      line-height: 1.7;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .msg-body pre {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
      padding: 12px;
      overflow-x: auto;
      font-family: var(--font-mono);
      font-size: 0.83rem;
      margin: 10px 0;
      direction: ltr;
      text-align: left;
    }
    .msg-error {
      margin-top: 10px;
      padding: 10px 12px;
      border-radius: 8px;
      background: var(--danger-dim);
      border: 1px solid rgba(224, 82, 82, 0.35);
      color: #f4a6a6;
      font-size: 0.82rem;
    }
    .msg-actions {
      margin-top: 10px;
      display: flex;
      gap: 8px;
    }
    .mini-btn {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      padding: 4px 9px;
      border-radius: 5px;
      font-size: 0.75rem;
      cursor: pointer;
    }
    .mini-btn:hover { color: var(--text-primary); border-color: var(--accent); }

    /* Composer */
    .composer-dock {
      padding: 12px 16px 18px;
      border-top: 1px solid var(--border-subtle);
      background: var(--bg-canvas);
    }
    .composer-box {
      width: 100%;
      max-width: 760px;
      margin: 0 auto;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 12px;
      text-align: start;
    }
    .composer-box:focus-within { border-color: var(--accent); }
    .composer-textarea {
      width: 100%;
      background: transparent;
      border: none;
      color: var(--text-primary);
      font-family: inherit;
      font-size: 0.93rem;
      line-height: 1.5;
      resize: none;
      outline: none;
      min-height: 64px;
      max-height: 220px;
    }
    .attachment-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 8px;
    }
    .att-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--bg-elevated);
      border: 1px solid var(--border-subtle);
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 0.76rem;
      color: var(--text-secondary);
    }
    .composer-toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding-top: 10px;
      border-top: 1px solid var(--border-subtle);
    }
    .toolbar-left { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }

    .mode-group {
      display: inline-flex;
      background: var(--bg-canvas);
      border: 1px solid var(--border-subtle);
      border-radius: 7px;
      padding: 2px;
    }
    .mode-btn {
      background: transparent;
      border: none;
      color: var(--text-secondary);
      font-size: 0.76rem;
      padding: 4px 10px;
      border-radius: 5px;
      cursor: pointer;
    }
    .mode-btn.active { background: var(--bg-elevated); color: var(--text-primary); font-weight: 500; }

    .task-chip {
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      font-size: 0.76rem;
      padding: 4px 9px;
      border-radius: 6px;
      cursor: pointer;
    }
    .task-chip.active {
      border-color: var(--accent);
      background: var(--accent-dim);
      color: var(--accent);
    }

    .send-btn {
      background: var(--accent);
      color: #0d0e11;
      border: none;
      border-radius: 7px;
      padding: 7px 16px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
    }
    .send-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .stop-btn {
      background: var(--danger-dim);
      color: #f4a6a6;
      border: 1px solid rgba(224, 82, 82, 0.4);
      border-radius: 7px;
      padding: 7px 14px;
      font-size: 0.82rem;
      cursor: pointer;
    }

    /* Modals */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.72);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 16px;
    }
    .modal-backdrop.open { display: flex; }
    .modal-card {
      width: 100%;
      max-width: 520px;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 20px;
    }
    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }
    .modal-title { font-size: 1rem; font-weight: 600; }
    .form-group { margin-bottom: 12px; }
    .form-label { display: block; font-size: 0.78rem; color: var(--text-secondary); margin-bottom: 5px; }
    .form-input, .form-select {
      width: 100%;
      background: var(--bg-canvas);
      border: 1px solid var(--border-subtle);
      color: var(--text-primary);
      padding: 8px 10px;
      border-radius: 7px;
      font-size: 0.85rem;
      outline: none;
    }
    .form-input:focus, .form-select:focus { border-color: var(--accent); }
    .help-text { font-size: 0.74rem; color: var(--text-secondary); margin-top: 4px; line-height: 1.4; }

    /* Sub-workspace view */
    .subview-card {
      margin: auto;
      max-width: 480px;
      text-align: center;
      padding: 28px;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
    }

    @media (max-width: 768px) {
      .sidebar { position: fixed; z-index: 50; height: 100%; }
      .sidebar.collapsed { width: 0; border: none; overflow: hidden; }
    }
  </style>
</head>
<body>
  <div class="app-shell">
    <!-- Sidebar -->
    <aside id="sidebar" class="sidebar">
      <div class="sidebar-header">
        <div class="brand hide-collapsed">JOMO <span>AI</span></div>
        <button id="toggleSidebarBtn" class="icon-btn" title="Toggle Sidebar">☰</button>
      </div>

      <div class="new-chat-wrap">
        <button id="newChatBtn" class="btn-new-chat">
          <span>+</span>
          <span class="hide-collapsed" data-i18n="newChat">New Chat</span>
        </button>
      </div>

      <nav class="nav-list">
        <button class="nav-item" id="cmdTriggerBtn">
          <span class="hide-collapsed" data-i18n="search">Search</span>
          <span class="badge hide-collapsed">Ctrl+K</span>
        </button>
        <button class="nav-item" data-view="library">
          <span class="hide-collapsed" data-i18n="library">Library</span>
          <span class="badge hide-collapsed">M2</span>
        </button>
        <button class="nav-item" data-view="projects">
          <span class="hide-collapsed" data-i18n="projects">Projects</span>
          <span class="badge hide-collapsed">M6</span>
        </button>
        <button class="nav-item" data-view="agents">
          <span class="hide-collapsed" data-i18n="agents">Agents</span>
          <span class="badge hide-collapsed">M4</span>
        </button>
        <button class="nav-item" data-view="studio">
          <span class="hide-collapsed" data-i18n="studio">Studio</span>
          <span class="badge hide-collapsed">M5</span>
        </button>
        <button class="nav-item" data-view="automations">
          <span class="hide-collapsed" data-i18n="automations">Automations</span>
          <span class="badge hide-collapsed">M6</span>
        </button>
      </nav>

      <div class="history-section hide-collapsed">
        <div class="history-title" data-i18n="history">Conversations</div>
        <div id="conversationList"></div>
      </div>

      <div class="sidebar-footer">
        <button class="nav-item" id="openSettingsBtn">
          <span class="hide-collapsed" data-i18n="settings">Settings &amp; Provider</span>
          <span>⚙</span>
        </button>
      </div>
    </aside>

    <!-- Main Workspace -->
    <main class="main-area">
      <header class="topbar">
        <div class="topbar-left">
          <button id="mobileMenuBtn" class="icon-btn">☰</button>
          <span id="workspaceTitle" class="workspace-label">JOMO AI Workspace</span>
          <span class="status-pill" id="providerStatusPill">
            <span class="dot" id="providerDot"></span>
            <span id="providerStatusText">Not Configured</span>
          </span>
        </div>

        <div class="lang-switch">
          <button class="lang-btn active" data-lang="en">English</button>
          <button class="lang-btn" data-lang="ar">العربية</button>
          <button class="lang-btn" data-lang="fr">Français</button>
        </div>
      </header>

      <div id="unconfiguredBanner" class="notice-banner">
        <span data-i18n="unconfiguredBanner">No live AI provider is connected. Configure Ollama (local/free) or an OpenAI-compatible API endpoint in Settings to stream real responses.</span>
        <button class="btn-link" id="bannerConfigBtn" data-i18n="configureNow">Configure</button>
      </div>

      <section id="canvasArea" class="canvas"></section>

      <div id="composerDock" class="composer-dock" style="display:none;"></div>
    </main>
  </div>

  <!-- Settings Modal -->
  <div id="settingsModal" class="modal-backdrop">
    <div class="modal-card">
      <div class="modal-header">
        <div class="modal-title" data-i18n="settingsTitle">Provider &amp; Workspace Settings</div>
        <button class="icon-btn" id="closeSettingsBtn">✕</button>
      </div>

      <div class="form-group">
        <label class="form-label" data-i18n="providerPreset">Provider Preset</label>
        <select id="providerPresetSelect" class="form-select">
          <option value="ollama">Ollama Local (Free — http://localhost:11434/v1)</option>
          <option value="groq">Groq Cloud (https://api.groq.com/openai/v1)</option>
          <option value="openrouter">OpenRouter (https://openrouter.ai/api/v1)</option>
          <option value="custom">Custom OpenAI-Compatible Endpoint</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Base URL</label>
        <input id="providerBaseUrl" class="form-input" placeholder="http://localhost:11434/v1" />
      </div>

      <div class="form-group">
        <label class="form-label">Model ID</label>
        <input id="providerModelId" class="form-input" placeholder="qwen2.5:7b" />
      </div>

      <div class="form-group">
        <label class="form-label">API Key (Optional for local Ollama)</label>
        <input id="providerApiKey" type="password" class="form-input" placeholder="sk-... or leave blank for Ollama" />
        <div class="help-text" data-i18n="securityNote">
          Stored only in your browser session storage for standalone local use. In production deployments, keep keys strictly on the backend server.
        </div>
      </div>

      <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:16px;">
        <button class="mini-btn" id="testConnectionBtn" data-i18n="testConnection">Test Connection</button>
        <button class="send-btn" id="saveSettingsBtn" data-i18n="save">Save</button>
      </div>
      <div id="settingsFeedback" class="help-text" style="margin-top:10px;"></div>
    </div>
  </div>

  <!-- Command Palette Modal -->
  <div id="cmdModal" class="modal-backdrop">
    <div class="modal-card" style="padding:0; overflow:hidden;">
      <input id="cmdInput" class="form-input" style="border:none; border-bottom:1px solid var(--border-subtle); border-radius:0; padding:14px 16px;" placeholder="Search conversations or actions..." />
      <div id="cmdResults" style="max-height:280px; overflow-y:auto; padding:8px;"></div>
    </div>
  </div>

